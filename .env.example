# Copy to .env.local for local development. Never commit real keys.

# Public site URL used in Stripe redirects (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional contact line on the privacy page.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Clerk (parent email magic link) ---
# Dashboard: https://dashboard.clerk.com
# Enable Email + Email verification link. Disable passwords for magic-link only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/library
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/unlock

# --- Stripe (test mode first) ---
# Use sk_test_ / pk_test_ until you are ready for live keys (see README).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Local UI preview of the unlocked library without Clerk/Stripe.
# Never enable this in production.
FOXTRAIL_DEV_UNLOCK=false
