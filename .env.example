# Copy to .env.local. Never commit real keys.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Local development only. Ignored in production, even if accidentally enabled.
FOXTRAIL_TEST_MODE=true
FOXTRAIL_DATABASE_PATH=./data/family.sqlite
NEXT_TELEMETRY_DISABLED=1

# Public deployment: set your real HTTPS origin, absolute persistent DB path,
# Clerk account keys, support contact, and your Clerk user ID as the owner.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
FOXTRAIL_OWNER_IDS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Connect Stripe TEST mode first. Full billing remains disabled without these.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Complete before opening public family registration. Do not put secrets in NEXT_PUBLIC keys.
QUESTBURROW_OPERATOR_NAME=
QUESTBURROW_OPERATOR_ADDRESS=
QUESTBURROW_OPERATOR_PHONE=
# Generate a random 32-byte key (64 hexadecimal characters) and store in host secrets.
QUESTBURROW_PRIVACY_KEY=
# Set true only after completing docs/PRIVACY-OPERATIONS.md.
QUESTBURROW_PRIVACY_OPERATIONS_READY=false
# A random secret of at least 32 characters for the daily retention job.
QUESTBURROW_MAINTENANCE_SECRET=
